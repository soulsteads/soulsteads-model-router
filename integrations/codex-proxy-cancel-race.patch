From 0ad41ed9ef56e86861f2f16b145de58c97bcfc9a Mon Sep 17 00:00:00 2001
From: Soulsteads contributors <contributors@example.invalid>
Date: Mon, 28 Sep 2026 01:56:51 +0000
Subject: [PATCH] Handle cancellation during Codex worker acquisition

---
 src/__tests__/server.test.ts | 19 ++++++++++++++++++-
 src/server/routes.ts         |  5 ++++-
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/src/__tests__/server.test.ts b/src/__tests__/server.test.ts
index ef0306e..c040689 100644
--- a/src/__tests__/server.test.ts
+++ b/src/__tests__/server.test.ts
@@ -2,7 +2,7 @@ import assert from "node:assert/strict";
 import { readFile } from "node:fs/promises";
 import test from "node:test";
 import { invalidRequestError } from "../server/errors.js";
-import { buildHealthPayload, buildVersionPayload } from "../server/routes.js";
+import { buildHealthPayload, buildVersionPayload, withAbort } from "../server/routes.js";
 import { VERSION } from "../server/version.js";
 
 test("health and version payloads expose version and safe runtime metadata", () => {
@@ -32,3 +32,20 @@ test("runtime version matches package version", async () => {
   const pkg = JSON.parse(await readFile(new URL("../../package.json", import.meta.url), "utf-8")) as { version: string };
   assert.equal(VERSION, pkg.version);
 });
+
+test("already-aborted turn observes its later worker rejection", async () => {
+  const controller = new AbortController();
+  controller.abort();
+  let rejectTurn!: (reason: Error) => void;
+  const turn = new Promise<string>((_resolve, reject) => {
+    rejectTurn = reject;
+  });
+  let abortCalls = 0;
+  await assert.rejects(
+    withAbort(turn, controller.signal, () => { abortCalls++; }),
+    { kind: "client_closed" },
+  );
+  assert.equal(abortCalls, 1);
+  rejectTurn(new Error("worker exited after cancellation"));
+  await new Promise((resolve) => setImmediate(resolve));
+});
diff --git a/src/server/routes.ts b/src/server/routes.ts
index 9cf892f..2e7f41d 100644
--- a/src/server/routes.ts
+++ b/src/server/routes.ts
@@ -651,11 +651,14 @@ async function runTurnOnce(
   }
 }
 
-function withAbort<T>(operation: Promise<T>, signal: AbortSignal | undefined, onAbort: () => void): Promise<T> {
+export function withAbort<T>(operation: Promise<T>, signal: AbortSignal | undefined, onAbort: () => void): Promise<T> {
   trace("with_abort.enter", { hasSignal: Boolean(signal), aborted: signal?.aborted });
   if (!signal) return operation;
   if (signal.aborted) {
     trace("with_abort.already_aborted");
+    // The operation may have started while a worker was being acquired. It
+    // still rejects after we kill that worker, so observe that rejection.
+    void operation.catch(() => undefined);
     onAbort();
     return Promise.reject(new CodexProxyError("client_closed", "client_closed"));
   }
-- 

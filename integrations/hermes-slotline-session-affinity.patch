 """
 
+import hashlib
 import json
 from typing import Any, Dict
 
@@ -50,6 +51,25 @@ def _static_prompt_instructions(messages: list[dict[str, Any]]) -> str:
         return str(content or "")
 
 
+def _add_slotline_session_header(api_kwargs: dict[str, Any], params: dict[str, Any]) -> None:
+    """Opt-in, bounded routing hint scoped by Slotline to the bearer key.
+
+    The cache scope survives Hermes context-compression session rotation. The
+    raw Hermes identifier stays local; only its domain-separated digest goes
+    over the wire. This header grants no authorization at the gateway.
+    """
+    overrides = params.get("request_overrides") or {}
+    if overrides.get("slotline_session_affinity") is not True:
+        return
+    scope = params.get("cache_scope_id") or params.get("session_id")
+    if not isinstance(scope, str) or not scope:
+        return
+    digest = hashlib.sha256(b"hermes-slotline-session-v1\0" + scope.encode()).hexdigest()
+    headers = dict(api_kwargs.get("extra_headers") or {})
+    headers["X-Slotline-Session"] = digest
+    api_kwargs["extra_headers"] = headers
+
+

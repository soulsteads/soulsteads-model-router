index 0000000000..8f7cf5213b
--- /dev/null
+++ b/tests/hermes_cli/test_slotline_session_affinity.py
@@ -0,0 +1,71 @@
+"""A configured Slotline provider sends a stable conversation routing hint."""
+
+from agent.transports.chat_completions import ChatCompletionsTransport
+from hermes_cli.config import _normalize_custom_provider_entry
+from hermes_cli.runtime_provider import _custom_provider_request_overrides
+from hermes_cli import runtime_provider
+from providers import get_provider_profile
+
+
+def _wire(scope, session, *, enabled=True):
+    provider = _normalize_custom_provider_entry({
+        "name": "slotline-local",
+        "base_url": "http://100.64.0.1:4011/v1",
+        "api_mode": "chat_completions",
+        "slotline_session_affinity": enabled,
+    })
+    overrides = _custom_provider_request_overrides(provider)
+    return ChatCompletionsTransport().build_kwargs(
+        "qwen38flash",
+        [{"role": "user", "content": "hello"}],
+        base_url=provider["base_url"],
+        request_overrides={**overrides, "extra_headers": {"X-Request-Source": "test"}},
+        cache_scope_id=scope,
+        session_id=session,
+    )
+
+
+def test_session_scope_survives_physical_session_rotation():
+    first = _wire("conversation-1", "physical-1")
+    rotated = _wire("conversation-1", "physical-2")
+    other = _wire("conversation-2", "physical-3")
+    header = first["extra_headers"]["X-Slotline-Session"]
+    assert len(header) == 64
+    assert "conversation" not in header
+    assert header == rotated["extra_headers"]["X-Slotline-Session"]
+    assert header != other["extra_headers"]["X-Slotline-Session"]
+    assert first["extra_headers"]["X-Request-Source"] == "test"
+    assert "slotline_session_affinity" not in first
+
+
+def test_opt_in_and_missing_scope_send_no_hint():
+    assert "X-Slotline-Session" not in _wire("conversation-1", "physical-1", enabled=False)["extra_headers"]
+    assert "X-Slotline-Session" not in _wire(None, None)["extra_headers"]
+
+
+def test_provider_profile_path_uses_the_same_header_contract():
+    wire = ChatCompletionsTransport().build_kwargs(
+        "qwen38flash",
+        [{"role": "user", "content": "hello"}],
+        provider_profile=get_provider_profile("qwen"),
+        request_overrides={"slotline_session_affinity": True},
+        cache_scope_id="conversation-1",
+        session_id="physical-2",
+    )
+    assert wire["extra_headers"]["X-Slotline-Session"] == _wire("conversation-1", "physical-1")["extra_headers"]["X-Slotline-Session"]
+    assert "slotline_session_affinity" not in wire
+
+
+def test_named_provider_resolution_carries_opt_in(monkeypatch):
+    monkeypatch.setattr(runtime_provider, "load_config", lambda: {"providers": {
+        "slotline-local": {
+            "name": "slotline-local",
+            "api": "http://100.64.0.1:4011/v1",
+            "transport": "chat_completions",
+            "api_key": "local-test-key",
+            "slotline_session_affinity": True,
+        }
+    }})
+    monkeypatch.setattr(runtime_provider, "_try_resolve_from_custom_pool", lambda *a, **k: None)
+    resolved = runtime_provider._resolve_named_custom_runtime(requested_provider="slotline-local")
+    assert resolved["request_overrides"] == {"slotline_session_affinity": True}

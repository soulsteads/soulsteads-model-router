# Example systemd user unit. Install the binary first; do not copy unchanged
# over an existing service. %h expands to the service user's home directory.
[Unit]
Description=Soulsteads Model Router (Soulsteads Router)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=%h/.local/bin/soulsteads-router --check-config %h/.config/soulsteads-router/config.yaml
ExecStart=%h/.local/bin/soulsteads-router %h/.config/soulsteads-router/config.yaml
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
